// Render PDF: make -C diagrams
// Dynamic data loading: the form declares what it reads; the runtime fetches what is not cached.
// Blue: request · pink: response · grey: cache reads and writes.
// Numbers: one round trip. After 13 the runtime plans again (2), so data that just arrived can
// unlock further requests: suppliers, then the picked supplier's details.
// Server side shows the example's fixture; a real backend only needs the same paths and JSON.
digraph DynamicLoading {
  graph [label="Lean Forms: dynamic data loading" labelloc=t fontsize=22
    fontname="sans-serif" rankdir=TB newrank=true nodesep=0.5 ranksep=0.5 bgcolor="white"];
  node [shape=box style="rounded,filled" fillcolor="#bfdbfe" color="#475569"
    fontname="sans-serif" fontsize=11 margin="0.15,0.10"];
  edge [color="#475569" fontname="sans-serif" fontsize=10];

  subgraph cluster_js {
    label="Browser (JavaScript)";
    fontsize=14; labeljust=l; labelloc=t; color="#059669"; penwidth=2; style=rounded;

    client [label=<<B>LeanForm.tsx</B><BR/>performs effects, reports responses> fillcolor="#bbebcd" color="#059669" penwidth=2.5];
  }

  subgraph cluster_wasm {
    label="Form runtime (Lean in Wasm)";
    fontsize=14; labeljust=l; labelloc=t; color="#d97706"; penwidth=2; style=rounded;

    execute [label="ModelForm.execute\nclear outbox, step the command, then load\noutbox: submit | fetch request"];
    requests [label="Component.requests (pure)\nrequests the form reads now\nskips hidden parts and unloaded data"];
    cache [label="HttpRequest.Cache\nrequest → loading | loaded | failed" fillcolor="#fff1cc"];
    render [label="render\nSource.resolve: Loading… / data / failure"];

    execute -> requests [color="#2563eb" fontcolor="#2563eb" label="2. value + cache"];
    execute -> requests [dir=back color="#db2777" fontcolor="#db2777" label="3. needed requests"];
    execute -> cache [label="4. mark missing as loading,\nqueue them in the outbox\n13. store response"];
    cache -> render [label="reads" style=dashed];
    { rank=same; requests; cache; }
  }

  subgraph cluster_server {
    label="Server (forms-web, native Lean)";
    fontsize=14; labeljust=l; labelloc=t; color="#7c3aed"; penwidth=2; style=rounded;

    call [label="Application.call\nPOST body, 1 MiB limit"];
    serve [label="Api.serve\nparse → handler → encode"];
    fixture [label="SupplierEndpoint.fixture\nhard-coded example data"];

    call -> serve [color="#2563eb" fontcolor="#2563eb" label="7. HttpRequest"];
    call -> serve [dir=back color="#db2777" fontcolor="#db2777" label="10. JSON"];
    serve -> fixture [color="#2563eb" fontcolor="#2563eb" label="8. endpoint + input"];
    serve -> fixture [dir=back color="#db2777" fontcolor="#db2777" label="9. output"];
  }

  client -> execute [color="#2563eb" fontcolor="#2563eb" label="1. command\ne.g. pick ACME"];
  client -> execute [dir=back color="#db2777" fontcolor="#db2777" label="5. snapshot\neffects: fetch { id, request }"];
  client -> execute [color="#2563eb" fontcolor="#2563eb" label="12. fetched { id, outcome }\noutcome: response | unreachable"];
  client -> call [color="#2563eb" fontcolor="#2563eb" label="6. fetch POST /api/supplier\n\"acme\""];
  client -> call [dir=back color="#db2777" fontcolor="#db2777" label="11. 200 + JSON"];
}
