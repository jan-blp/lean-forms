import Std

open System

/-
Discover reachable Lean modules and generate their constant initializers.
Pinned to Lean 4.34.1's generated C layout. Bootstrap C is only a symbol index:
core modules are regenerated by the installed Lean compiler. Make owns all
cross-compilation and linking. Run from the repository root.
-/
namespace DiscoverWasm

def out : FilePath := ".lake/wasm"
def work : FilePath := out / "json-build"
def bootstrap : FilePath := out / "toolchains/lean4-4.34.1/stage0/stdlib"
def makefile := "experiments/wasm/Makefile"

def report (message : String) : IO Unit := do
  let stdout ← IO.getStdout
  stdout.putStrLn message
  stdout.flush

def identifierChar (c : Char) : Bool := c.isAlphanum && c.toNat < 128 || c == '_'
def identifier (s : String) : Bool := !s.isEmpty && s.toList.all identifierChar

def words (s : String) : List String :=
  (s.splitOn " ").filter (!·.isEmpty)

-- These parsers deliberately recognize the pinned compiler's C declarations,
-- rather than attempting to parse general C.
def exportedSymbol (line : String) : Option (String × Bool) := do
  let line ← line.dropPrefix? "LEAN_EXPORT "
  let line := line.toString
  if line.contains '(' then
    let parts := line.splitOn "("
    let name ← (words parts.head!).getLast?
    if identifier name && !line.contains ';' && (line.endsWith "{" || line.endsWith ")") then
      some (name, false)
    else none
  else
    let [ty, name] := words line | none
    if !(["lean_object*", "uint8_t", "uint16_t", "uint32_t", "uint64_t",
        "int8_t", "int16_t", "int32_t", "int64_t", "size_t", "double", "float"].contains ty) then
      none
    else
      let name ← name.dropSuffix? ";"
      if identifier name.toString then some (name.toString, true) else none

def importedInitializer (line : String) : Option String := do
  let name ← line.dropPrefix? "lean_object* "
  let name ← name.dropSuffix? "(uint8_t builtin);"
  let name := name.toString
  if identifier name && (["initialize_", "runtime_initialize_", "meta_initialize_"].any fun start => name.startsWith start) then
    some name
  else none

structure Source where
  path : FilePath
  text : String
  globals : Array String := #[]
  imports : Array String := #[]
  selected : Bool := false
  constants : Std.HashSet String := {}
  deriving Inhabited

structure Discovery where
  sources : Array Source := #[]
  symbols : Std.HashMap String Nat := {}

abbrev Discover := StateRefT Discovery IO

def register (id : Nat) (text : String) : Discover Unit := do
  let mut globals := #[]
  let mut imports := #[]
  -- Move the index out of the state so insertion can update it in place.
  let mut symbols ← modifyGet fun s => (s.symbols, { s with symbols := {} })
  for line in text.splitOn "\n" do
    if let some (name, global) := exportedSymbol line then
      symbols := symbols.insert name id
      if global then globals := globals.push name
    if let some name := importedInitializer line then imports := imports.push name
  modify fun s => { s with symbols, sources := s.sources.modify id fun src =>
    { src with text, globals, imports } }

def make (targets : Array String) (capture := false) : IO IO.Process.Output := do
  let result ← IO.Process.output {
    cmd := "make"
    args := #["--no-print-directory", "-f", makefile, "-j4"] ++ targets }
  unless capture do
    (← IO.getStdout).putStr result.stdout
    (← IO.getStderr).putStr result.stderr
    if result.exitCode != 0 then throw <| IO.userError "Make failed"
  return result

def writeChanged (path : FilePath) (text : String) : IO Unit := do
  if ← path.pathExists then
    if (← IO.FS.readFile path) == text then return
  if let some parent := path.parent then IO.FS.createDirAll parent
  IO.FS.writeFile path text

def select (id : Nat) : Discover Unit := do
  let src := (← get).sources[id]!
  if src.selected then return
  if let some relative := src.path.toString.dropPrefix? (bootstrap.toString ++ "/") then
    let generated := work / "core" / relative.toString
    discard <| make #[generated.toString]
    register id (← IO.FS.readFile generated)
  modify fun s => { s with sources := s.sources.modify id fun src => { src with selected := true } }

def selectedSources (s : Discovery) : Array Nat :=
  ((List.range s.sources.size).toArray.filter fun i => s.sources[i]!.selected).qsort
    (fun i j => s.sources[i]!.path.toString < s.sources[j]!.path.toString)

-- Sorted source IDs give unique hook names without an external hashing tool.
def hook (id : Nat) : String := s!"json_constants_{id}"

def moduleSource (id : Nat) : Discover FilePath := do
  let src := (← get).sources[id]!
  let mut text := src.text
  if !src.constants.isEmpty then
    let mut statements : Array String := #[]
    let mut found : Std.HashSet String := {}
    let lines := src.text.splitOn "\n"
    let lineSet : Std.HashSet String := Std.HashSet.ofList lines
    for line in lines do
      let parts := line.splitOn " = "
      let symbol := parts.head!
      if src.constants.contains symbol then
        let [_, rhs] := parts | throw <| IO.userError s!"Unsupported initialization: {line}"
        let some fn := rhs.dropSuffix? "();"
          | throw <| IO.userError s!"Unsupported initialization: {line}"
        unless identifier fn.toString && fn.startsWith "_init_" do
          throw <| IO.userError s!"Unsupported initialization: {line}"
        if found.contains symbol then
          throw <| IO.userError s!"Duplicate constant initializer: {symbol} in {src.path}"
        found := found.insert symbol
        statements := statements.push line
        let persistent := s!"lean_mark_persistent({symbol});"
        if lineSet.contains persistent then statements := statements.push persistent
    unless found.size == src.constants.size do
      throw <| IO.userError s!"Missing constant initializer in {src.path}"
    text := text ++ "\nvoid " ++ hook id ++ "(void) {\n" ++
      String.intercalate "\n" statements.toList ++ "\n}\n"
  -- Keep each candidate so repeated discovery can reuse compiled objects.
  -- A hash collision must fail rather than silently reuse the wrong C source.
  let path := work / s!"module-{id}-{hash text}.c"
  if ← path.pathExists then
    unless (← IO.FS.readFile path) == text do
      throw <| IO.userError s!"Generated source hash collision: {path}"
  else
    IO.FS.writeFile path text
  return path

partial def visit (s : Discovery) (id : Nat)
    (visited : Std.HashSet Nat) (ordered : Array Nat) : Std.HashSet Nat × Array Nat := Id.run do
  if visited.contains id then return (visited, ordered)
  let mut visited := visited.insert id
  let mut ordered := ordered
  for name in s.sources[id]!.imports do
    if let some dep := s.symbols[name]? then
      (visited, ordered) := visit s dep visited ordered
  if !s.sources[id]!.constants.isEmpty then ordered := ordered.push id
  return (visited, ordered)

def initializeSource : Discover FilePath := do
  let s ← get
  let mut visited := {}
  let mut ordered := #[]
  for id in selectedSources s do
    (visited, ordered) := visit s id visited ordered
  let declarations := ordered.map fun id => "void " ++ hook id ++ "(void);"
  let calls := ordered.map fun id => hook id ++ "();"
  let text := String.intercalate "\n" declarations.toList ++
    "\nvoid json_initialize_constants(void) {\n" ++ String.intercalate "\n" calls.toList ++ "\n}\n"
  let path := work / "initialize.c"
  writeChanged path text
  return path

def missingSymbols (stderr : String) : Std.HashSet String := Id.run do
  let mut missing := {}
  for part in (stderr.splitOn "undefined symbol: ").drop 1 do
    let name := String.ofList (part.toList.takeWhile identifierChar)
    if !name.isEmpty then missing := missing.insert name
  return missing

def retainedSymbols (mapText : String) : Std.HashSet String := Id.run do
  let mut names := {}
  for line in mapText.splitOn "\n" do
    let name := String.ofList ((line.trimAscii.toString.toList.reverse.takeWhile identifierChar).reverse)
    if !name.isEmpty then names := names.insert name
  return names

def discover : Discover Unit := do
  for _ in [:80] do
    let mut paths := #[]
    for id in selectedSources (← get) do paths := paths.push (← moduleSource id)
    paths := paths.push (← initializeSource)
    writeChanged (work / "modules.mk") ("LEAN_OBJECTS := " ++
      String.intercalate " " (paths.toList.map fun p => (p.withExtension "o").toString) ++ "\n")
    let result ← make #["link"] true
    if result.exitCode != 0 then
      let missing := missingSymbols result.stderr
      let s ← get
      let mut additions : Std.HashSet Nat := {}
      if missing.isEmpty then throw <| IO.userError (result.stdout ++ result.stderr)
      for name in missing do
        let some id := s.symbols[name]? | throw <| IO.userError result.stderr
        if s.sources[id]!.selected then throw <| IO.userError result.stderr
        additions := additions.insert id
      report s!"Adding {additions.size} Lean modules ({(selectedSources s).size + additions.size} total)"
      for id in additions.toArray.qsort (fun i j => s.sources[i]!.path.toString < s.sources[j]!.path.toString) do
        select id
    else
      let retained := retainedSymbols (← IO.FS.readFile (work / "link.map"))
      let mut added := 0
      for id in selectedSources (← get) do
        let src := (← get).sources[id]!
        let mut constants := src.constants
        for symbol in src.globals do
          if !constants.contains symbol && retained.contains symbol then
            constants := constants.insert symbol
            added := added + 1
        modify fun s => { s with sources := s.sources.modify id fun src => { src with constants } }
      if added > 0 then
        report s!"Initializing {added} additional retained constants"
      else
        let s ← get
        let ids := selectedSources s
        writeChanged (work / "modules.txt")
          (String.intercalate "\n" (ids.toList.map fun id => s.sources[id]!.path.toString) ++ "\n")
        let constants := ids.flatMap fun id => s.sources[id]!.constants.toArray.qsort (· < ·)
        writeChanged (work / "constants.txt") (String.intercalate "\n" constants.toList ++ "\n")
        return
  throw <| IO.userError "Dependency/initialization closure did not converge"

def cFiles (dir : FilePath) : IO (Array FilePath) := do
  if !(← dir.pathExists) then return #[]
  return ((← dir.walkDir).filter (·.extension == some "c")).qsort (fun a b => a.toString < b.toString)

def run : Discover Unit := do
  let mut paths ← cFiles bootstrap
  for path in ← cFiles ".lake/build/ir/Forms" do
    -- Branch changes can leave C for deleted modules in Lake's build directory.
    -- Those stale definitions must not shadow the current project's symbols.
    let some source := path.toString.dropPrefix? ".lake/build/ir/"
      | throw <| IO.userError s!"Unexpected project artifact: {path}"
    if ← (FilePath.mk source.toString |>.withExtension "lean").pathExists then
      paths := paths.push path
  let packages ← (FilePath.mk ".lake/packages").readDir
  for package in packages.qsort (fun a b => a.path.toString < b.path.toString) do
    paths := paths ++ (← cFiles (package.path / ".lake/build/ir"))
  paths := paths.push (out / "JsonEval.c")
  for path in paths do
    let id := (← get).sources.size
    modify fun s => { s with sources := s.sources.push { path, text := "" } }
    register id (← IO.FS.readFile path)
  select (paths.size - 1)
  discover

end DiscoverWasm

def main : IO Unit := do
  discard <| DiscoverWasm.run.run {}
