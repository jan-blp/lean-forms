digraph SharedState {
  graph [bgcolor="transparent", rankdir=TB, nodesep=0.5, ranksep=0.65,
         pad=0.15, fontname="DejaVu Sans", fontsize=16];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans",
        fontsize=16, margin="0.22,0.18", penwidth=1.5,
        fontcolor="#364152"];
  edge [dir=both, fontname="DejaVu Sans", fontsize=12, color="#59636e",
        fontcolor="#364152", penwidth=1.3, arrowsize=0.7];

  shared [label="Shared count: 7", color="#3454a5", fillcolor="#f0f3fc"];
  first [label="Consumer 1\nPrivate count: 1", color="#137c80", fillcolor="#edf7f6"];
  second [label="Consumer 2\nPrivate count: 2", color="#137c80", fillcolor="#edf7f6"];
  added [label="New consumer\nPrivate count: 0", style="rounded,filled,dashed",
         color="#b7791f", fillcolor="#fff4d6"];

  { rank=same; first; second; added; }
  shared -> first [label="read / update"];
  shared -> second [label="read / update"];
  shared -> added [label="read / update"];
}
