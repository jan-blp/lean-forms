digraph NestedThermostatConstraints {
  graph [rankdir=TB, bgcolor="transparent", pad=0.15, nodesep=0.65,
         ranksep=0.4, fontname="DejaVu Sans", fontsize=18];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans",
        fontsize=18, margin="0.22,0.14", color="#3454A5",
        fillcolor="white", fontcolor="#18243A", penwidth=1.5];
  edge [color="#526078", penwidth=1.8, arrowsize=0.7];

  subgraph cluster_global {
    label="Away ≤ Home";
    labelloc=b;
    style="rounded,filled";
    color="#7B3FA1";
    fillcolor="#F2EAF8";
    fontcolor="#633184";
    penwidth=2;
    margin=22;

    thermostat [label="thermostat : record"];
    subgraph cluster_home {
      label="Home ≤ 30";
      style="rounded,filled";
      color="#137C80";
      fillcolor="#E3F4F1";
      fontcolor="#126467";
      margin=16;
      subgraph cluster_home_lower {
        label="5 ≤ Home";
        style="rounded,filled";
        color="#3454A5";
        fillcolor="#E8EEFC";
        fontcolor="#3454A5";
        margin=16;
        home [label="home : natural", color="#3454A5"];
      }
    }
    subgraph cluster_away {
      label="Away ≤ 30";
      style="rounded,filled";
      color="#137C80";
      fillcolor="#E3F4F1";
      fontcolor="#126467";
      margin=16;
      subgraph cluster_away_lower {
        label="5 ≤ Away";
        style="rounded,filled";
        color="#3454A5";
        fillcolor="#E8EEFC";
        fontcolor="#3454A5";
        margin=16;
        away [label="away : natural", color="#3454A5"];
      }
    }
    thermostat -> home;
    thermostat -> away;
  }
}
