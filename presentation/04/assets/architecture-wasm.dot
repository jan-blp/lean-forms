digraph Architecture {
  graph [bgcolor="transparent", rankdir=LR, nodesep=0.7, ranksep=0.6,
         pad=0.15, fontname="DejaVu Sans", fontsize=16,
         fontcolor="#364152", newrank=true];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans",
        fontsize=16, margin="0.22,0.18", penwidth=1.5];
  edge [fontname="DejaVu Sans", fontsize=12, color="#59636e",
        fontcolor="#364152", penwidth=1.3, arrowsize=0.8];

  subgraph cluster_server {
    label="Server"; style="rounded,dashed"; color="#59636e"; margin=16;
    lean [color="#3454a5", fillcolor="#f0f3fc",
      label="Lean\nDescribe form + types\nValidate result"];
  }

  subgraph cluster_browser {
    label="Browser"; style="rounded,dashed"; color="#59636e"; margin=16;
    client [color="#3454a5", fillcolor="#f0f3fc", penwidth=3,
      label="Lean (Wasm)\nState, checks, layout"];
    react [color="#137c80", fillcolor="#edf7f6",
      label="React\nRender and forward input"];
  }

  specification [shape=ellipse, style=filled,
    color="#b7791f", fillcolor="#fff4d6", fontsize=14,
    label="JSON\ninitial value"];
  submission [shape=ellipse, style=filled,
    color="#b7791f", fillcolor="#fff4d6", fontsize=14,
    label="JSON\nsubmission"];

  { rank=same; specification; submission; }
  lean -> specification -> react;
  lean -> submission -> react [dir=back];
  react -> client [label="command"];
  react -> client [label="snapshot", dir=back];
  specification -> submission [style=invis];
}
