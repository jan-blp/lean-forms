import Lake
open Lake DSL System

package «lean-forms» where
  version := v!"0.1.0"
  testDriver := "tests"
  leanOptions := #[
    { name := `autoImplicit
      value := false },
    { name := `relaxedAutoImplicit
      value := false }]

require batteries from git "https://github.com/jan-blp/batteries" @ "v4.35.0-wasm.1"
require mathlib from git "https://github.com/jan-blp/mathlib4" @ "v4.35.0-wasm.1"
require «lean-lens» from git "https://github.com/janmasrovira/lean-lens" @ "816a71f8264c700c200d01149ac43e96ae5d694a"

@[default_target]
lean_lib Forms

@[default_target]
lean_lib FormsReact

lean_lib FormTests where
  globs := #[.submodules `Tests]

@[default_target]
lean_exe tests where
  root := `Tests

/-- Generates the protocol files and bundles the web app, unless its inputs are unchanged. -/
target webAssets pkg : FilePath := do
  let roots ← #[`Forms.Runtime.Wire, `Forms.Runtime.Web, `FormsReact.Component, `Forms.Protocol.TypeScript].mapM fun name => do
    let some mod := pkg.findModule? name | error s!"Missing protocol module {name}"
    return mod
  -- The generator runs code from every transitive import, but an importer's trace only covers
  -- the public interface of its imports, so trace each module's own sources too.
  let mut closure : Std.HashMap Lean.Name Module := {}
  for root in roots do
    closure := closure.insert root.name root
    for mod in ← (← root.transImports.fetch).await do
      closure := closure.insert mod.name mod
  let modules ← closure.toArray.qsort (·.1.quickLt ·.1) |>.mapM fun (_, mod) => mod.leanArts.fetch
  -- web/tsconfig.json includes every web/*.tsx.
  let webSources := (← (pkg.dir / "web").readDir).filterMap fun entry =>
    if entry.path.extension == some "tsx" then some entry.path else none
  let config := #["tools/GenerateProtocol.lean", "package-lock.json", "web/package.json", "web/tsconfig.json",
    "packages/react/package.json", "packages/react/tsconfig.json"].map fun (file : String) => pkg.dir / file
  let files ← (config ++ webSources.qsort (·.toString < ·.toString)).mapM fun file => inputTextFile file
  let src := pkg.dir / "packages" / "react" / "src"
  -- Generated by this target, so not an input.
  let react ← inputDir src (text := true) fun path =>
    !path.toString.startsWith s!"{src / "protocol"}/"
  let inputs := (Job.mixArray modules).mix (Job.mixArray files) |>.mix react
  inputs.mapM fun _ => do
    let app := pkg.dir / "web" / "dist" / "app.js"
    let stamp := pkg.dir / "web" / "dist" / "outputs.hash"
    let outputsHash : JobM Hash := do
      let mut hash := Hash.nil
      for dir in #[src / "protocol", pkg.dir / "web" / "generated", pkg.dir / "packages" / "react" / "dist"] do
        if ← dir.isDir then
          for file in (← dir.walkDir).qsort (·.toString < ·.toString) do
            unless ← file.isDir do
              hash := hash.mix (Hash.ofString file.toString) |>.mix (← computeFileHash file)
      return hash
    -- Only app.js carries the trace; drop it if another output was deleted or edited, forcing a rebuild.
    if (← Hash.load? stamp) != some (← outputsHash) then
      removeFileIfExists app
    buildFileUnlessUpToDate' app (text := true) do
      unless ← (pkg.dir / "node_modules").isDir do
        error "npm dependencies missing; run `npm ci`"
      -- A failed build may leave generated files half-updated; a missing bundle forces the next rebuild.
      removeFileIfExists app
      proc {
        cmd := "npm"
        args := #["--prefix", (pkg.dir / "web").toString, "run", "build:prepared", "--silent"]
      }
      IO.FS.writeFile stamp (← outputsHash).toString
    return app

@[default_target]
lean_exe «forms-web» where
  root := `WebMain
  extraDepTargets := #[`webAssets]

lean_lib Browser where
  roots := #[`WasmEntry]
  srcDir := "wasm"

/-- Collect the modules needed to run the form in the browser.
Unlike Lake's `transImports`, this skips `meta import` dependencies.
Excluding them avoids compiling their generated C to Wasm and saves compilation time. -/
private def runtimeModules (root : Module) : FetchM (Array Module) := do
  let mut pending := [root]
  let mut visited := Lean.NameSet.empty
  let mut modules := #[]
  while let mod :: rest := pending do
    pending := rest
    if visited.contains mod.name then continue
    visited := visited.insert mod.name
    modules := modules.push mod
    let input ← (← mod.input.fetch).await
    -- Non-`module` init functions call every import, meta ones included.
    unless input.header.isModule do
      error s!"{mod.name}: runtime import filtering requires `module`"
    for imp in input.imports do
      -- Skipped modules stay referenced by unused init functions; wasm-ld drops those.
      unless imp.isMeta do
        if let some dependency := imp.module? then
          pending := dependency :: pending
  return modules

-- Use Lake's dependency graph, without inspecting or rewriting generated C.
target browserSources pkg : FilePath := do
  let some root := pkg.findModule? `WasmEntry
    | error "Missing browser entry module"
  let modules ← runtimeModules root
  let jobs ← modules.mapM fun mod => mod.c.fetch
  Job.async do
    let files ← jobs.mapM fun job => job.await
    let path := pkg.buildDir / "browser-sources.txt"
    let contents := String.intercalate "\n" (files.toList.map (·.toString)) ++ "\n"
    if ← path.pathExists then
      if (← IO.FS.readFile path) == contents then return path
    IO.FS.createDirAll pkg.buildDir
    IO.FS.writeFile path contents
    return path
